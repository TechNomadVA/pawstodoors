{
  "name": "paws2doors",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "pages:build": "npx @cloudflare/next-on-pages",
    "pages:dev": "npx wrangler pages dev .vercel/output/static --compatibility-flag=nodejs_compat --d1=DB=paws2doors",
    "pages:deploy": "npm run build && npm run pages:build && npx wrangler pages deploy .vercel/output/static --project-name=paws2doors",
    "d1:create": "npx wrangler d1 create paws2doors",
    "d1:migrate:local": "npx wrangler d1 execute paws2doors --local --file=./d1/migrations/001_initial.sql",
    "d1:migrate:remote": "npx wrangler d1 execute paws2doors --remote --file=./d1/migrations/001_initial.sql"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.47.10",
    "next": "14.2.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^2.0.0",
    "@cloudflare/workers-types": "^4.20241127.0",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.18",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3"
  }
}
